<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

  <!-- Rust Core (EchoCore) Build Configuration for FFI Tests -->
  <PropertyGroup>
    <EchoCoreDirectory>$(MSBuildThisFileDirectory)..\..\src\core\</EchoCoreDirectory>
    <!-- Use rustup's proxy so rust-toolchain.toml selects the pinned toolchain. -->
    <EchoCoreCargo Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">$(USERPROFILE)\.cargo\bin\cargo.exe</EchoCoreCargo>
    <EchoCoreCargo Condition="'$(EchoCoreCargo)' == ''">cargo</EchoCoreCargo>
    
    <EchoCoreProfile Condition="'$(Configuration)' == 'Release'">release</EchoCoreProfile>
    <EchoCoreProfile Condition="'$(EchoCoreProfile)' == ''">debug</EchoCoreProfile>
    
    <RustTargetTriple Condition="'$(Platform)' == 'arm64'">aarch64-pc-windows-msvc</RustTargetTriple>
    <RustTargetTriple Condition="'$(RustTargetTriple)' == ''">x86_64-pc-windows-msvc</RustTargetTriple>
    
    <EchoCoreCargoArguments Condition="'$(Configuration)' == 'Release'">--release --target $(RustTargetTriple)</EchoCoreCargoArguments>
    <EchoCoreCargoArguments Condition="'$(Configuration)' != 'Release'">--target $(RustTargetTriple)</EchoCoreCargoArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\ui\Audio\AudioFrame.cs" Link="Audio\AudioFrame.cs" />
    <Compile Include="..\..\src\ui\Visualizers\SpectralBarMath.cs" Link="Visualizers\SpectralBarMath.cs" />
    <Compile Include="..\..\src\ui\Audio\AudioCoreService.cs" Link="Audio\AudioCoreService.cs" />
    <Compile Include="..\..\src\ui\Audio\EchoCoreNative.cs" Link="Audio\EchoCoreNative.cs" />
    <Compile Include="..\..\src\ui\ViewModels\VisualizerViewModel.cs" Link="ViewModels\VisualizerViewModel.cs" />
    <Compile Include="..\..\src\ui\ViewModels\CatalogViewModel.cs" Link="ViewModels\CatalogViewModel.cs" />
    <Compile Include="..\..\src\ui\ViewModels\SettingsViewModel.cs" Link="ViewModels\SettingsViewModel.cs" />
    <Compile Include="..\..\src\ui\Services\UserSettingsService.cs" Link="Services\UserSettingsService.cs" />
    <Compile Include="..\..\src\ui\Services\ThemePreference.cs" Link="Services\ThemePreference.cs" />
  </ItemGroup>

  <Target Name="BuildEchoCoreForFfiTests" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(EchoCoreCargo)&quot; build --manifest-path &quot;$(EchoCoreDirectory)Cargo.toml&quot; $(EchoCoreCargoArguments)" />
  </Target>

  <Target Name="CopyEchoCoreForFfiTests" AfterTargets="Build" BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" DependsOnTargets="BuildEchoCoreForFfiTests" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ActualEchoCoreOutput Condition="Exists('$(EchoCoreDirectory)target\$(RustTargetTriple)\$(EchoCoreProfile)\echo_core.dll')">$(EchoCoreDirectory)target\$(RustTargetTriple)\$(EchoCoreProfile)\echo_core.dll</ActualEchoCoreOutput>
      <ActualEchoCoreOutput Condition="'$(ActualEchoCoreOutput)' == '' And Exists('$(EchoCoreDirectory)target\$(EchoCoreProfile)\echo_core.dll')">$(EchoCoreDirectory)target\$(EchoCoreProfile)\echo_core.dll</ActualEchoCoreOutput>
    </PropertyGroup>
    <Error Condition="'$(ActualEchoCoreOutput)' == '' Or !Exists('$(ActualEchoCoreOutput)')" Text="EchoCore native library was not produced for FFI tests." />
    <Copy SourceFiles="$(ActualEchoCoreOutput)" DestinationFiles="$(TargetDir)EchoCore.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
