<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Product.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Version Condition="'$(Version)' == ''">$(EchoProductVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(EchoProductVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(EchoProductVersion)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(EchoProductVersion)</InformationalVersion>
    <RootNamespace>EchoVisualizer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- RF6.1.6: embed the canonical multi-resolution Win32 icon. -->
    <ApplicationIcon>$(EchoApplicationIcon)</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or '$(Platform)' == 'arm64' Or '$(Platform)' == 'ARM64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

<!-- GitHub Unpackaged Self-Contained Profile -->
<PropertyGroup Condition="'$(BuildingForGitHub)' == 'true' Or '$(WindowsPackageType)' == 'None'">
  <WindowsPackageType>None</WindowsPackageType>

  <!-- Required by Windows App SDK to merge WinUI framework resources into the
       unpackaged PRI graph. This does not create an MSIX package. -->
  <EnableMsixTooling>true</EnableMsixTooling>

  <AppxPackage>false</AppxPackage>

  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

  <!-- Required for unpackaged WinUI/WinRT activation without package identity. -->
  <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>

  <SelfContained>true</SelfContained>

  <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\github\$(RuntimeIdentifier)\</PublishDir>
</PropertyGroup>

  <!-- Store Packaged MSIX Profile (Default) -->
  <PropertyGroup Condition="'$(BuildingForGitHub)' != 'true' And '$(WindowsPackageType)' != 'None'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <MicrosoftWindowsSDKBuildToolsMSIXPackageVersion>1.7.20250829.1</MicrosoftWindowsSDKBuildToolsMSIXPackageVersion>
    <AppxPackage>true</AppxPackage>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- One architecture-specific unsigned .msix per runtime identifier. The
         Store requires each uploaded package to have a unique package full
         name; per-architecture bundles are neutral and collide. Single
         packages carry their architecture (x64/arm64) in the identity. -->
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\artifacts\store\</AppxPackageDir>
    <AppxPackageSigningEnabled Condition="'$(SignMsix)' == 'true'">true</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <!-- Echo does not use Windows App SDK Main/Singleton deployment APIs. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>

  <!-- Rust Core (EchoCore) Build Configuration -->
  <PropertyGroup>
    <EchoCoreDirectory>$(MSBuildThisFileDirectory)..\core\</EchoCoreDirectory>
    <!-- Resolve Cargo through rustup/PATH so rust-toolchain.toml controls the
         exact toolchain and installed cross-compilation targets. -->
    <EchoCoreCargo Condition="'$(EchoCoreCargo)' == ''">cargo</EchoCoreCargo>
    
    <EchoCoreProfile Condition="'$(Configuration)' == 'Release'">release</EchoCoreProfile>
    <EchoCoreProfile Condition="'$(EchoCoreProfile)' == ''">debug</EchoCoreProfile>
    
    <!-- Target triple resolution for x64 vs arm64 -->
    <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or '$(Platform)' == 'arm64'">aarch64-pc-windows-msvc</RustTargetTriple>
    <RustTargetTriple Condition="'$(RustTargetTriple)' == ''">x86_64-pc-windows-msvc</RustTargetTriple>
    
    <EchoCoreCargoArguments Condition="'$(Configuration)' == 'Release'">--release --target $(RustTargetTriple)</EchoCoreCargoArguments>
    <EchoCoreCargoArguments Condition="'$(Configuration)' != 'Release'">--target $(RustTargetTriple)</EchoCoreCargoArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- RF6.1.6: packaged and unpackaged profiles publish the same generated assets. -->
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\**\*.*" />
  </ItemGroup>

  <!-- Allows local/CI builds to use a generated manifest without modifying the
       repository's normative Package.appxmanifest version. -->
  <ItemGroup Condition="'$(PackageManifestOverride)' != ''">
    <AppxManifest Include="$(PackageManifestOverride)">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <Target Name="BuildEchoCore" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(EchoCoreCargo)&quot; build --manifest-path &quot;$(EchoCoreDirectory)Cargo.toml&quot; $(EchoCoreCargoArguments)" />
  </Target>

  <Target Name="CopyEchoCore" AfterTargets="Build" BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems;AssignTargetPaths" DependsOnTargets="BuildEchoCore" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ActualEchoCoreOutput Condition="Exists('$(EchoCoreDirectory)target\$(RustTargetTriple)\$(EchoCoreProfile)\echo_core.dll')">$(EchoCoreDirectory)target\$(RustTargetTriple)\$(EchoCoreProfile)\echo_core.dll</ActualEchoCoreOutput>
      <ActualEchoCoreOutput Condition="'$(ActualEchoCoreOutput)' == '' And Exists('$(EchoCoreDirectory)target\$(EchoCoreProfile)\echo_core.dll')">$(EchoCoreDirectory)target\$(EchoCoreProfile)\echo_core.dll</ActualEchoCoreOutput>
    </PropertyGroup>
    <Error Condition="'$(ActualEchoCoreOutput)' == '' Or !Exists('$(ActualEchoCoreOutput)')" Text="EchoCore native library was not produced." />
    <Copy SourceFiles="$(ActualEchoCoreOutput)" DestinationFiles="$(TargetDir)EchoCore.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ActualEchoCoreOutput)" DestinationFiles="$(PublishDir)EchoCore.dll" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <ItemGroup>
      <None Include="$(ActualEchoCoreOutput)">
        <Link>EchoCore.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>
</Project>
