<UserControl
    x:Class="EchoVisualizer.Controls.PresetCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootCard">

    <Grid x:Name="ContainerGrid" Width="152" Height="96">
        <Border x:Name="CardBorder"
                Background="{ThemeResource BrushBgElevated}"
                BorderBrush="{ThemeResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Grid.Row="0"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{ThemeResource BrushTextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />

                <!-- Center Preview Thumbnail Placeholder / Icon -->
                <FontIcon Grid.Row="1"
                          Glyph="&#xE9D9;"
                          FontSize="24"
                          Foreground="{ThemeResource BrushTextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

                <ToggleButton x:Name="FavoriteButton"
                              Grid.Row="2"
                              HorizontalAlignment="Right"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              Click="FavoriteButton_Click">
                    <FontIcon x:Name="StarIcon"
                              Glyph="&#xE734;"
                              FontSize="14"
                              Foreground="{ThemeResource BrushTextSecondary}" />
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Selected Indicator Border -->
        <Border x:Name="SelectedBorder"
                BorderBrush="{ThemeResource BrushAccent}"
                BorderThickness="2"
                CornerRadius="10"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
