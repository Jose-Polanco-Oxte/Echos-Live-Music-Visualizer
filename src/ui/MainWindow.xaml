<Window
    x:Class="EchoVisualizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Echo Visualizer">

    <Grid x:Name="RootLayout" Background="{ThemeResource BrushBgBase}" KeyDown="Grid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Grid x:Name="AppTitleBar" Height="36" Background="{ThemeResource BrushBgElevated}" Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="Assets/Square44x44Logo.png" Width="22" Height="22" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Echo" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource BrushTextPrimary}" />
                    <TextBlock Text="Visualizer" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource BrushTextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Navigation Frame -->
        <Frame x:Name="RootFrame" Grid.Row="1" NavigationFailed="RootFrame_NavigationFailed" />
    </Grid>
</Window>
