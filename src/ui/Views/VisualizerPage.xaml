<Page
    x:Class="EchoVisualizer.Views.VisualizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:EchoVisualizer.Controls"
    Background="{ThemeResource BrushBgBase}">

    <Grid x:Name="RootViewportGrid" Background="Transparent" PointerMoved="RootViewportGrid_PointerMoved">
        <!-- Layer 0: Win2D Canvas for Direct2D GPU Batching Visualizer Rendering -->
        <canvas:CanvasControl x:Name="Win2DCanvas" ClearColor="#060810" />

        <!-- Layer 1: SplitView for Personalizar (Ecualizador Espectral) Sidebar -->
        <SplitView x:Name="SettingsSplitView"
                   DisplayMode="Inline"
                   PanePlacement="Left"
                   OpenPaneLength="280"
                   IsPaneOpen="False">
            <SplitView.Pane>
                <Grid Background="{ThemeResource BrushBgElevated}" Padding="16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header (No Overlap) -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ajustes del Ecualizador Espectral" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <Button Grid.Column="1" x:Name="CloseSidebarButton" Background="Transparent" BorderThickness="0" Click="CloseSidebarButton_Click" Padding="4">
                            <FontIcon Glyph="&#xE10A;" FontSize="14" Foreground="{ThemeResource BrushTextSecondary}" />
                        </Button>
                    </Grid>

                    <!-- Sidebar Settings Controls -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Band Count Slider (12 to 128, step 4) -->
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Bandas espectrales" FontSize="13" Foreground="{ThemeResource BrushTextSecondary}" />
                                    <TextBlock x:Name="BandCountValueText" Text="48" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="BandCountSlider" Minimum="12" Maximum="128" StepFrequency="4" Value="48" ValueChanged="BandCountSlider_ValueChanged" />
                            </StackPanel>

                            <!-- Layout Combo -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Disposición (Layout)" FontSize="13" Foreground="{ThemeResource BrushTextSecondary}" />
                                <ComboBox x:Name="LayoutSelector" SelectedIndex="0" SelectionChanged="LayoutSelector_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Bottom-Up (Inferior)" />
                                    <ComboBoxItem Content="Top-Down (Superior)" />
                                    <ComboBoxItem Content="Center-Out / Espejo (Centro)" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Color Mode Combo -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Paleta de colores" FontSize="13" Foreground="{ThemeResource BrushTextSecondary}" />
                                <ComboBox x:Name="ColorModeSelector" SelectedIndex="0" SelectionChanged="ColorModeSelector_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Dinámico (AudioMapped)" />
                                    <ComboBoxItem Content="Paleta personalizada" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Custom Color Pickers -->
                            <StackPanel x:Name="CustomColorPanel" Spacing="12" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="Color Primario" FontSize="12" Foreground="{ThemeResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Border x:Name="PrimaryColorPreview" Width="28" Height="24" CornerRadius="4" Background="#26DEFF" BorderBrush="{ThemeResource BrushBorderSubtle}" BorderThickness="1" />
                                        <DropDownButton Content="Editar">
                                            <DropDownButton.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="PrimaryColorPicker" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="PrimaryColorPicker_ColorChanged" />
                                                </Flyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Color Secundario" FontSize="12" Foreground="{ThemeResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Border x:Name="SecondaryColorPreview" Width="28" Height="24" CornerRadius="4" Background="#FF3E9A" BorderBrush="{ThemeResource BrushBorderSubtle}" BorderThickness="1" />
                                        <DropDownButton Content="Editar">
                                            <DropDownButton.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="SecondaryColorPicker" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="SecondaryColorPicker_ColorChanged" />
                                                </Flyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- Layer 2: Main Overlay Content -->
            <SplitView.Content>
                <Grid x:Name="OverlayRootGrid" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- TopBar Overlay -->
                    <Grid x:Name="TopBarOverlay" Grid.Row="0" Padding="20,16" Background="Transparent">
                        <!-- Left Controls -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                            <ToggleButton x:Name="PencilButton" Style="{StaticResource ToolbarPillToggleButtonStyle}" Click="PencilButton_Click">
                                <ToggleButton.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            <TextBlock Text="Personalizar" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ToggleButton.ContentTemplate>
                            </ToggleButton>

                            <Button x:Name="CatalogButton" Style="{StaticResource ToolbarPillButtonStyle}" Click="CatalogButton_Click">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                                            <TextBlock Text="Catálogo" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>

                        <!-- Right Controls -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="SettingsButton" Style="{StaticResource ToolbarPillButtonStyle}" Click="SettingsButton_Click">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                                            <TextBlock Text="Configuración" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>

                            <Button x:Name="FullScreenButton" Style="{StaticResource ToolbarPillButtonStyle}" Click="FullScreenButton_Click">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE740;" FontSize="14" />
                                            <TextBlock Text="Pantalla Completa" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Area Grid (Contains BottomOverlay + Independent Floating EyeButton) -->
                    <Grid Grid.Row="2" Padding="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- BottomOverlay Dock Structure (Centered, MinWidth=680px) -->
                        <Grid x:Name="BottomOverlay" Grid.Column="0" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Button "Modo aleatorio" aligned to top-right corner of Dock Container -->
                            <Button x:Name="RandomModeButton" Grid.Row="0" Content="Modo aleatorio" Style="{StaticResource ToolbarPillButtonStyle}" HorizontalAlignment="Right" Margin="0,0,0,6">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                            <TextBlock Text="Modo aleatorio" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>

                            <!-- Dock Carousel Container (MinWidth="680px", MaxWidth="840px") -->
                            <Border x:Name="DockContainer"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    MinWidth="680"
                                    MaxWidth="840"
                                    Background="{ThemeResource BrushDockBg}"
                                    BorderBrush="{ThemeResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,12">
                                <ScrollViewer HorizontalScrollMode="Enabled"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Disabled">
                                    <StackPanel x:Name="PresetStripRow" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                                        <controls:PresetCard PresetTitle="Ecualizador de Barras Espectral" IsSelectedPreset="True" IsFavoritePreset="True" CardSize="Small" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Independent Floating EyeButton in Bottom-Right Corner -->
                        <ToggleButton x:Name="EyeButton"
                                      Grid.Column="1"
                                      Style="{StaticResource CircularToggleButtonStyle}"
                                      VerticalAlignment="Bottom"
                                      Margin="16,0,0,0"
                                      Click="EyeButton_Click">
                            <FontIcon x:Name="EyeIcon" Glyph="&#xE890;" FontSize="18" Foreground="{ThemeResource BrushTextPrimary}" />
                        </ToggleButton>
                    </Grid>
                </Grid>
            </SplitView.Content>
        </SplitView>

        <!-- Layer 3: 5-Second Photosensitive Disclaimer Overlay (App-level Single Run) -->
        <Grid x:Name="DisclaimerOverlayGrid" Background="{ThemeResource BrushBgBase}" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="760" Padding="40">
                <FontIcon Glyph="&#xE7BA;" FontSize="56" Foreground="#FFCC00" HorizontalAlignment="Center" />
                <TextBlock Text="Advertencia" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Esta aplicación contiene efectos visuales cromáticos y patrones reactivos a la música que pueden afectar a personas fotosensibles o con epilepsia."
                           FontSize="18"
                           LineHeight="28"
                           Foreground="{ThemeResource BrushTextPrimary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBlock x:Name="DisclaimerCountdownText"
                           Text="Puedes continuar en 5 ..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource BrushAccent}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
